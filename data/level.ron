(
    environment: "tm2-sky.hdr",
    gravity: 9.81,
    average_luminocity: 1.0,
    light_dir: (0.35, 1.0, 0.25),
    light_color: (1.5, 1.4, 1.2),
    ambient_color: (0.22, 0.23, 0.26),
    spawn_pos: (0, 2, 0),
    ground: (
        name: "ground",
        visuals: [
            (
                model: "ground.gltf",
                pos: (0, 1, 0),
            ),
            (
                // Warm asphalt overlay so the pale kit ground doesn't wash out.
                model: "arena-plaza.gltf",
                pos: (0, 1.02, 0),
            ),
            (
                model: "arena-walls.gltf",
            ),
            (
                // Visual-only monument past the parked target. Scale keeps the
                // wide base readable; the official screenshot camera frames
                // the full silhouette. No collider.
                model: "landmark-tower.gltf",
                pos: (0, 1, 16.5),
                scale: 0.7,
            ),
            (
                // Planters and rooftop vents, off the fire lane and pad.
                model: "arena-props.gltf",
                pos: (0, 1.02, 0),
            ),
        ],
        colliders: [
            (
                density: 1.0,
                friction: 1.0,
                shape: Cuboid(
                    half: (20, 1, 20),
                ),
            ),
            (
                density: 1.0,
                friction: 1.0,
                shape: Cuboid(
                    half: (20, 1, 1),
                ),
                pos: (21, 2, 0),
                rot: (0, 90, 0),
            ),
            (
                density: 1.0,
                friction: 1.0,
                shape: Cuboid(
                    half: (20, 1, 1),
                ),
                pos: (-21, 2, 0),
                rot: (0, 90, 0),
            ),
            (
                density: 1.0,
                friction: 1.0,
                shape: Cuboid(
                    half: (20, 1, 1),
                ),
                pos: (0, 2, 21),
                rot: (0, 0, 0),
            ),
            (
                density: 1.0,
                friction: 1.0,
                shape: Cuboid(
                    half: (20, 1, 1),
                ),
                pos: (0, 2, -21),
                rot: (0, 0, 0),
            ),
        ],
    ),
)
